{
 "admin": {
  "address": {
   "socket_address": {
    "address": "127.0.0.1",
    "port_value": 9921
   }
  }
 },
 "static_resources": {
  "clusters": [
   {
    "connect_timeout": "1s",
    "lb_policy": "ROUND_ROBIN",
    "load_assignment": {
     "cluster_name": "origin",
     "endpoints": [
      {
       "lb_endpoints": [
        {
         "endpoint": {
          "address": {
           "socket_address": {
            "address": "127.0.0.1",
            "port_value": 8092
           }
          }
         }
        }
       ]
      }
     ]
    },
    "name": "origin",
    "type": "STATIC"
   }
  ],
  "listeners": [
   {
    "address": {
     "socket_address": {
      "address": "127.0.0.1",
      "port_value": 10110
     }
    },
    "connection_balance_config": {
     "exact_balance": {}
    },
    "filter_chains": [
     {
      "filters": [
       {
        "name": "envoy.filters.network.http_connection_manager",
        "typed_config": {
         "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
         "codec_type": "HTTP1",
         "http_filters": [
          {
           "name": "envoy.filters.http.router",
           "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
           }
          }
         ],
         "route_config": {
          "name": "local",
          "virtual_hosts": [
           {
            "domains": [
             "*"
            ],
            "name": "service",
            "routes": [
             {
              "match": {
               "path": "/s"
              },
              "route": {
               "cluster": "origin"
              }
             },
             {
              "match": {
               "path": "/sh"
              },
              "route": {
               "cluster": "origin"
              }
             }
            ]
           }
          ]
         },
         "stat_prefix": "ingress_http"
        }
       }
      ],
      "transport_socket": {
       "name": "envoy.transport_sockets.tls",
       "typed_config": {
        "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext",
        "common_tls_context": {
         "tls_certificates": [
          {
           "certificate_chain": {
            "filename": "~/epl/runs/sm/01-tls-cert/certs/rsa2048.crt"
           },
           "private_key": {
            "filename": "~/epl/runs/sm/01-tls-cert/certs/rsa2048.key"
           }
          }
         ]
        },
        "disable_stateful_session_resumption": true,
        "disable_stateless_session_resumption": true
       }
      }
     }
    ],
    "name": "listener_0"
   }
  ]
 }
}
